# Deterministic text checkout while keeping authored local binary assets intact.
* text=auto
*.ts text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
